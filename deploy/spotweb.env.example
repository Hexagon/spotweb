# /etc/spotweb/spotweb.env  (chmod 640, root:spotweb)

# ENTSO-e Transparency Platform API token (required for prices, production, load, outages).
# Request one at https://transparency.entsoe.eu/ (My account settings -> Web API Security Token).
API_TOKEN=

# Listen only on localhost, put a reverse proxy (Caddy/nginx) with TLS in front.
SPOTWEB_BIND=127.0.0.1
SPOTWEB_PORT=6000

# SQLite database (relative to WorkingDirectory=/var/lib/spotweb)
SPOTWEB_DB=/var/lib/spotweb/spotweb.db

# Public url, used for sitemap.xml, robots.txt and Home Assistant examples
#SPOTWEB_PUBLIC_URL=https://spot.example.com

# Optional
#SPOTWEB_ADSENSE=ca-pub-XXXXXXXXXXXXXXXX
#SPOTWEB_GA_ID=G-XXXXXXXXXX
#SPOTWEB_SCHEDULE_TZ=Europe/Stockholm
#SPOTWEB_HISTORY_START=2021-01-01
#SPOTWEB_REQUEST_DELAY_MS=2000
#SPOTWEB_ENTSOE_CONCURRENCY=3
#SPOTWEB_ENTSOE_TIMEOUT_SECS=60
#SPOTWEB_SHUTDOWN_GRACE_SECS=15

# Rate limit /api/ per client IP (requests per minute, 429 + Retry-After over that; default off).
# Behind a reverse proxy on this host, also trust its X-Forwarded-For, otherwise every visitor
# shares the proxy's address. The nginx example limits /api/ itself.
#SPOTWEB_API_RATE_LIMIT=60
#SPOTWEB_TRUSTED_PROXIES=127.0.0.1,::1
#RUST_LOG=spotweb=info,warn
