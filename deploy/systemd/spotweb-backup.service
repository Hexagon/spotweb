# /etc/systemd/system/spotweb-backup.service
# Consistent online copy of the database, safe while spotweb is running.
[Unit]
Description=spotweb database backup

[Service]
Type=oneshot
User=spotweb
Group=spotweb
EnvironmentFile=/etc/spotweb/spotweb.env
# systemd creates both directories owned by spotweb:spotweb; no mkdir binary is needed, so this
# works whether or not /usr is merged into / (on unmerged systems mkdir is only at /bin/mkdir).
StateDirectory=spotweb spotweb/backup
StateDirectoryMode=0750
WorkingDirectory=/var/lib/spotweb
# The .zst suffix makes spotweb compress the copy (roughly 5-10x smaller). Restore with `zstd -d`.
# The uncompressed copy is written next to it first, so keep free space for one full database.
ExecStart=/bin/sh -c 'exec /usr/local/bin/spotweb backup /var/lib/spotweb/backup/spotweb-$(date +%%u).db.zst'
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
