# /etc/systemd/system/spotweb.service
[Unit]
Description=spotweb - electricity spot prices
Documentation=https://github.com/Hexagon/spotweb
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spotweb
Group=spotweb
EnvironmentFile=/etc/spotweb/spotweb.env
# Database lives in /var/lib/spotweb (created by systemd, owned by the service user)
StateDirectory=spotweb
StateDirectoryMode=0750
WorkingDirectory=/var/lib/spotweb
ExecStart=/usr/local/bin/spotweb serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening. Works with systemd >= 245 (Ubuntu 20.04, Debian 11). On systemd >= 247 also
# install spotweb.service.d/proc.conf for ProtectProc/ProcSubset, see docs/deployment.md.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
